# Copy to .env.local for local dev, and add both to Vercel's Environment Variables.
# Neon dashboard -> your project -> Connection string (the pooled one is fine).
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Signs the session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-plus-random-characters
